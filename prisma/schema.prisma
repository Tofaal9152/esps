generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  studentId String
  email     String
  course    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
